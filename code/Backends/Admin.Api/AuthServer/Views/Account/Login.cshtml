@{
    ViewData["Title"] = "Login page";
}

<div class="box-container">
    <div class="form-container">
        <form class="form-box">
            <div>
                <div>icon</div>
                <h1>AudioNova</h1>
            </div>
            <h2>Sign In</h2>
            <p>Enter your email and password to continue</p>
            <input class="w-100 mb-10 bor-radius-4" placeholder="Email Address" />
            <input class="w-100 mb-10 bor-radius-4" placeholder="Password" />
            <button class="w-100 bor-radius-4">Sign In</button>
            <div class="sc-7">
                <hr class="line" /> <span class="mg-5">or continue with:</span><hr class="line" />
            </div>
            <button class="w-100 mb-10 bor-radius-4">
                <span>icon google</span>
                <p>Sign in with Google</p>
            </button>
            <button class="w-100 mb-10 bor-radius-4">
                <span>icon facebook</span>
                <p>Sign in with Facebook</p>
            </button>
            <div>
                <span>Don't have an account?</span>
                <span>Sign up</span>
            </div>
        </form>
    </div>
</div>
