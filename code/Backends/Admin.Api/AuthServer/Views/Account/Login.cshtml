@{
    ViewData["Title"] = "Login page";
}

<div class="box-container">
    <div class="form-container">
        <form class="form-box" action="/account/login" method="post">
            <div class="corner-top"></div>
            <div class="corner-bottom"></div>
            <div class="flex justify-content-center" style="align-items: center; margin-bottom: 12px;">
                <img class="img-icon" style="width: 50px; height: 50px; margin: 0;" src="/images/icons/audio.png" alt="audio" />
                <b style="font-size: 24px;">AudioNova</b>
            </div>
            <h2 class="flex justify-content-center">Sign In</h2>
            <p class="flex justify-content-center">Enter your email and password to continue</p>
            <input class="w-100 mb-10 bor-radius-4" name="Username" placeholder="Email Address" />
            <input class="w-100 mb-10 bor-radius-4" name="Password" placeholder="Password" />
            <button class="btn w-100 bor-radius-4 justify-content-center btn-sign">Sign In</button>
            <div class="sc-7">
                <hr class="line" /> <span class="mg-5">or continue with:</span><hr class="line" />
            </div>
            <button class="btn w-100 mb-10 bor-radius-4">
                <img class="img-icon" src="/images/icons/Igoogle.png" alt="Google"/>
                <span>Sign in with Google</span>
            </button>
            <button class="btn w-100 mb-10 bor-radius-4">
                <img class="img-icon" src="/images/icons/Ifacebook.jpg" alt="Facebook" />
                <span>Sign in with Facebook</span>
            </button>
            <div class="flex justify-content-center">
                <span>Don't have an account?</span>
                <span class="ml-5" style="color: #f59e0b; cursor: pointer;">Sign up</span>
            </div>
        </form>
    </div>
</div>
